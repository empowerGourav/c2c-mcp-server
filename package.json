{
  "name": "c2c-mcp-server",
  "version": "0.1.0",
  "description": "Read-only MCP server exposing approved, aggregate Calls-to-Convert (C2C) reporting data to authenticated Claude clients",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "grants": "tsx scripts/print-grants.ts",
    "start:local": "node --env-file=.env dist/index.js",
    "credential": "tsx scripts/new-credential.ts",
    "diagnose:call-log": "tsx --env-file=.env scripts/diagnose-call-log.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "5.3.0",
    "jose": "6.2.17",
    "mysql2": "3.24.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
