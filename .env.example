# ---- Runtime --------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=8080
# Comma-separated Host header allowlist (required in production when binding 0.0.0.0)
ALLOWED_HOSTS=localhost,127.0.0.1
# Public HTTPS URL of the MCP endpoint (used for OAuth resource metadata)
MCP_PUBLIC_URL=https://c2c-mcp.example.com/mcp
MCP_MAX_REQUEST_BODY=64kb

# ---- OAuth 2.1 / OIDC (plan §7.1; issuer still to be confirmed) -----------
# Entra ID example: https://login.microsoftonline.com/<tenant-id>/v2.0
OAUTH_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
OAUTH_AUDIENCE=api://c2c-mcp-server
OAUTH_REQUIRED_SCOPES=c2c.reporting.read
# Entra ID: prefer `oid` (stable per user); generic OIDC: `sub`
OAUTH_SUBJECT_CLAIM=sub
OAUTH_ALLOWED_ALGORITHMS=RS256
OAUTH_DISCOVERY_TIMEOUT_MS=5000

# ---- Read-only reporting database (engine provisional: MySQL) --------------
DB_HOST=c2c-reporting-replica.internal
DB_PORT=3306
DB_NAME=c2c_reporting
DB_USER=mcp_reporting_reader
# Inject from a managed secret store (Key Vault reference); never commit a real value
DB_PASSWORD=change-me
DB_SSL_CA_PATH=
DB_SSL_DISABLED=false
DB_CONNECTION_LIMIT=5
DB_STATEMENT_TIMEOUT_MS=5000

# ---- Data allowlist (empty until owner + security sign-off, plan §4.1) ----
# e.g. C2C_APPROVED_VIEWS=mcp_v_campaign_daily,mcp_v_call_outcome_daily
C2C_APPROVED_VIEWS=
# Approved outcome_code enumeration, e.g. ANSWERED,CONVERTED,NO_ANSWER
C2C_OUTCOME_CODES=
C2C_DATA_FRESHNESS_NOTE=Freshness has not been confirmed by the C2C data owner.

# ---- Identity mapping & audit ---------------------------------------------
PRINCIPAL_MAP_PATH=./config/principals.json
# Secret, >= 16 chars; used to hash principal IDs in audit logs
AUDIT_HASH_SALT=change-me-to-a-long-random-value

# ---- Limits (plan §5.2 defaults) ------------------------------------------
QUERY_DEFAULT_WINDOW_DAYS=30
QUERY_MAX_LOOKBACK_DAYS=90
RESPONSE_MAX_ROWS=500
RESPONSE_MAX_BYTES=131072
MIN_AGGREGATE_GROUP_SIZE=10
MAX_CAMPAIGN_REFS_PER_PRINCIPAL=1000
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_QUERIES=10
MAX_CONCURRENT_QUERIES_PER_USER=2
