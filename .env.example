# ---- Runtime --------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=8080
# Comma-separated Host header allowlist (required in production when binding 0.0.0.0)
ALLOWED_HOSTS=localhost,127.0.0.1
# Public HTTPS URL of the MCP endpoint (used for OAuth resource metadata)
MCP_PUBLIC_URL=https://c2c-mcp.example.com/mcp
MCP_MAX_REQUEST_BODY=64kb

# ---- OAuth 2.1 / OIDC (issuer still to be confirmed) -----------------------
# Entra ID example: https://login.microsoftonline.com/<tenant-id>/v2.0
OAUTH_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
OAUTH_AUDIENCE=api://c2c-mcp-server
OAUTH_REQUIRED_SCOPES=c2c.reporting.read
# Claim carrying the user's e-mail; matched to users.email (status 8) in C2C
OAUTH_IDENTITY_CLAIM=email
OAUTH_ALLOWED_ALGORITHMS=RS256
OAUTH_DISCOVERY_TIMEOUT_MS=5000

# ---- Aurora MySQL: use the cluster READER endpoint (Laravel REPLICATE_DB_HOST)
DB_HOST=c2c-cluster.cluster-ro-xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
# Same schema as Laravel DB_DATABASE
DB_NAME=c2c
# Dedicated read-only user; grants: `npm run grants -- <db> <user> <host>`
DB_USER=mcp_reporting_reader
# Inject from a secret store; never commit a real value
DB_PASSWORD=change-me
# AWS RDS global CA bundle (pre-installed in the container image)
DB_SSL_CA_PATH=./certs/rds-global-bundle.pem
DB_SSL_DISABLED=false
DB_CONNECTION_LIMIT=5
DB_STATEMENT_TIMEOUT_MS=5000
MAX_PARALLEL_PROCEDURES=3

# ---- Reporting & identity -------------------------------------------------
DEFAULT_TIMEZONE=America/Chicago
# Super admins (users.role_id = 1) see all customers; off by default
ALLOW_SUPER_ADMIN=false
PRINCIPAL_CACHE_TTL_MS=60000
# Secret, >= 16 chars; used to hash user identities in audit logs
AUDIT_HASH_SALT=change-me-to-a-long-random-value

# ---- Limits (plan §5.2 defaults) ------------------------------------------
QUERY_DEFAULT_WINDOW_DAYS=30
QUERY_MAX_LOOKBACK_DAYS=90
RESPONSE_MAX_ROWS=500
RESPONSE_MAX_BYTES=131072
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_QUERIES=10
MAX_CONCURRENT_QUERIES_PER_USER=2
